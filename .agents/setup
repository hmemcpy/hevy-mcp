#!/usr/bin/env bash
# Orb setup for hevy-mcp. Runs once on a fresh orb (and on stale snapshots).
# Must stay non-interactive, idempotent, and fast; long-lived services do not
# belong here. See CONTRIBUTING.md for the documented toolchain.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Keep in sync with the "packageManager" field in package.json.
expected_bun="1.3.14"

step() { printf '\n=== [%s] %s ===\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"; }

step "Bun ${expected_bun}"
current_bun="$(bun --version 2>/dev/null || true)"
if [[ "$current_bun" == "$expected_bun" ]]; then
  echo "Bun ${current_bun} already installed."
else
  echo "Found Bun ${current_bun:-none}; installing ${expected_bun} globally."
  # npm refuses to overwrite a bin file it does not own (the base template's
  # Bun), so replace exactly its two bin names first.
  rm -f /usr/local/bin/bun /usr/local/bin/bunx
  npm install --global "bun@${expected_bun}"
  hash -r
fi

step "Dependencies (bun install --frozen-lockfile)"
# The package postinstall generates src/exercise-catalog.generated.json from
# exercise-catalog.local.json when present, or an empty catalog otherwise.
bun install --frozen-lockfile

step ".dev.vars"
if [[ -f .dev.vars ]]; then
  echo "Already present; leaving it untouched."
else
  cp -- .dev.vars.example .dev.vars
  echo "Created .dev.vars with placeholder values; fill in real credentials before 'bun run dev' (see docs/deployment.md)."
fi

step "Versions"
printf 'bun %s | node %s\n' "$(bun --version)" "$(node --version)"
